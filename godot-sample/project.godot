; Even G2 Debug Bridge - Godot Sample
; Godot Engine 4.7.x
config_version=5

[application]
config/name="Even G2 Debug Bridge Godot Sample"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

[display/window]
size/viewport_width=960
size/viewport_height=540
size/window_width_override=960
size/window_height_override=540
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

debug/settings/stdout/print_fps=false
