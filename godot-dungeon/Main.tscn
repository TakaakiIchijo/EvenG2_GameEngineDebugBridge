fog_density = 0.012

[sub_resource type="Shader" id="Shader_retro"]
code = "shader_type canvas_item;\n\nuniform sampler2D screen_texture : hint_screen_texture, filter_nearest;\nuniform vec2 virtual_resolution = vec2(320.0, 180.0);\nuniform float combat_desaturation = 0.0;\n\nvoid fragment() {\n    vec2 pixel_uv = floor(SCREEN_UV * virtual_resolution) / virtual_resolution;\n    vec3 color = texture(screen_texture, pixel_uv).rgb;\n    float scanline = 0.97 + 0.03 * sin(SCREEN_UV.y * virtual_resolution.y * 3.14159265);\n    float ordered = fract(sin(dot(floor(SCREEN_UV * virtual_resolution), vec2(12.9898, 78.233))) * 43758.5453);\n    float luma = dot(color, vec3(0.299, 0.587, 0.114));\n    color = mix(color, vec3(luma), combat_desaturation);\n    color = floor(color * 16.0 + ordered * 0.16) / 16.0;\n    COLOR = vec4(color * scanline, 1.0);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_retro"]
shader = SubResource("Shader_retro")

